BOT_TOKEN=123456789:replace-with-token-from-botfather
OWNER_USER_ID=123456789
STICKER_SET_NAME=doom_refresh_probe_by_your_bot
STICKER_SET_TITLE=DOOM Sticker Refresh Probe

# Optional paths and timing defaults
STATE_FILE=./data/state.json
LOG_FILE=./logs/api.jsonl
DEFAULT_INTERVAL_MS=10000
DEFAULT_SLOT_DELAY_MS=0

# Required for `play`
DOOM_WAD_PATH=/absolute/path/to/doom1.wad

# Optional native runtime paths
DOOM_EXECUTABLE=./native/bin/doomgeneric-headless
DOOM_FRAME_FILE=./data/doom-frame.ppm
DOOM_WORKING_DIRECTORY=./data/doom-runtime
DOOM_STARTUP_TIMEOUT_MS=20000
